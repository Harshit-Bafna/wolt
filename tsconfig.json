{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": ["./*"],
            "@/assets/*": ["./assets/*"],
            "@/data/*": ["./src/data/*"],
            "@/hooks/*": ["./src/hooks/*"],
            "@/services/*": ["./src/services/*"],
            "@/zustand/*": ["./src/zustand/*"],
            "@/constants/*": ["./src/constants/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
